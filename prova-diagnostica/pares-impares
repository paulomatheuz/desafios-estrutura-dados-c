/*
Questão 2: Contagem de Pares e Ímpares

Faça um programa que leia um vetor de 10 números inteiros
e informe quantos valores são pares e quantos são ímpares.
*/

#include <stdio.h>

int main() {
    int numeros[10];
    int contadorPar = 0;
    int contadorImpar = 0;

    for (int i = 0; i < 10; i++) {
        printf("Digite o numero da posicao %d: ", i);
        scanf("%d", &numeros[i]);
    }

    for (int i = 0; i < 10; i++) {
        if (numeros[i] % 2 == 0) {
            contadorPar++;
        } else {
            contadorImpar++;
        }
    }

    printf("\nQuantidade de pares: %d\n", contadorPar);
    printf("Quantidade de impares: %d\n", contadorImpar);

    return 0;
}
