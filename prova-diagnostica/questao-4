/*
Questão 4: Matriz Identidade

Faça um programa que leia um número n entre 2 e 10 correspondente
à ordem de uma matriz. A seguir, crie e exiba uma matriz identidade
de ordem n.

*/

#include <stdio.h>

int main() {
    int n;
    int matriz[10][10];

    printf("Digite um numero entre 2 e 10: ");
    scanf("%d", &n);

    if (n < 2 || n > 10) {
        printf("Erro: o numero deve estar entre 2 e 10.\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (i == j) {
                matriz[i][j] = 1;
            } else {
                matriz[i][j] = 0;
            }
        }
    }

    printf("\nMatriz identidade de ordem %d:\n", n);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            printf("%d ", matriz[i][j]);
        }

        printf("\n");
    }

    return 0;
}
