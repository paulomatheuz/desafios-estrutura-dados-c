/*
Questão 3: Menor e Maior Valor de um Vetor

Faça um programa que leia um vetor de tamanho 10 com valores inteiros
e informe qual é o menor e o maior valor contido no vetor.
*/

#include <stdio.h>

int main() {
    int numeros[10];

    for (int i = 0; i < 10; i++) {
        printf("Digite o valor da posicao %d: ", i);
        scanf("%d", &numeros[i]);
    }

    int maior = numeros[0];
    int menor = numeros[0];

    for (int i = 1; i < 10; i++) {
        if (numeros[i] > maior) {
            maior = numeros[i];
        }

        if (numeros[i] < menor) {
            menor = numeros[i];
        }
    }

    printf("Maior numero: %d\n", maior);
    printf("Menor numero: %d\n", menor);

    return 0;
}
