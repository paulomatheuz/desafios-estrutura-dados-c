/*
Questão 3: Soma da Diagonal Principal

Faça um programa que leia uma matriz 4x4 de números inteiros
e calcule a soma dos elementos da diagonal principal.
Ao final, mostre a soma obtida.
*/

#include <stdio.h>

int main() {
    int matriz[4][4];
    int soma = 0;

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            printf("Digite o valor de matriz[%d][%d]: ", i, j);
            scanf("%d", &matriz[i][j]);
        }
    }

    for (int i = 0; i < 4; i++) {
        soma += matriz[i][i];
    }

    printf("\nSoma da diagonal principal: %d\n", soma);

    return 0;
}
